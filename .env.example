# Public HTTPS origin Linear can reach (reverse proxy or tunnel to HOST:PORT).
BASE_URL=https://relay.example.com
HOST=127.0.0.1
PORT=8787
# Protects /linear/install?secret=…  (openssl rand -hex 24)
INSTALL_SECRET=

# Linear OAuth app (Settings → API → OAuth applications), webhooks: Agent session events.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

T3CODE_URL=http://localhost:3773
# Relay on the T3 host: it signs in and renews by itself with a pairing code.
T3CODE_RENEW_COMMAND=t3 auth pairing create --json --ttl 5m --label linear-t3-relay --scope orchestration:read --scope orchestration:operate
# Otherwise: `npm run t3:login` writes a 30-day bearer here (approve with "Full access").
T3CODE_TOKEN=
T3CODE_MODEL=claudeAgent/claude-sonnet-5
# Optional model options, e.g. {"contextWindow":"1m","effort":"high"}
T3CODE_MODEL_OPTIONS=
# T3 project title every issue goes to, or a map by Linear project name ("*" = fallback):
T3CODE_PROJECT=
# T3CODE_PROJECTS={"Backend":"api","*":"monorepo"}

STATE_PATH=./data/state.json
POLL_MS=3000
# worktree (default): one per issue on its Linear branch. root: the project's own checkout.
T3CODE_WORKSPACE=worktree
# Comma-separated Linear user ids allowed to delegate or prompt; empty allows everyone.
ALLOWED_USER_IDS=
