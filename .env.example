# Public HTTPS origin Linear can reach (reverse proxy or tunnel to HOST:PORT).
BASE_URL=https://relay.example.com
HOST=127.0.0.1
PORT=8787
# Protects /linear/install?secret=…  (openssl rand -hex 24)
INSTALL_SECRET=

# Linear OAuth app (Settings → API → OAuth applications), webhooks: Agent session events.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# T3 Code environment; `npm run t3:login` fills both (approve with "Full access").
T3CODE_URL=http://localhost:3773
T3CODE_TOKEN=
T3CODE_MODEL=claudeAgent/claude-sonnet-5
# Optional model options, e.g. {"contextWindow":"1m","effort":"high"}
T3CODE_MODEL_OPTIONS=
# T3 project title every issue goes to, or a map by Linear project name ("*" = fallback):
T3CODE_PROJECT=
# T3CODE_PROJECTS={"Backend":"api","*":"monorepo"}

STATE_PATH=./data/state.json
POLL_MS=3000
